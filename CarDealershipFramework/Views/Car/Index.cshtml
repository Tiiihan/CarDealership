@model IEnumerable<CarDealershipFramework.ViewModels.CarViewModel>

@{
    ViewBag.Title = "Cars";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Cars</h2>
    <div>
        @Html.ActionLink("City statistics", "Statistics", "Car", null, new { @class = "btn btn-outline-secondary" })
        @Html.ActionLink("Add car", "Create", "Car", null, new { @class = "btn btn-primary" })
    </div>
</div>

@if (!Model.Any())
{
    <p>No cars have been added yet.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Make</th>
                <th>Model</th>
                <th>Manufacture year</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var car in Model)
        {
            <tr>
                <td>@car.Make</td>
                <td>@car.Model</td>
                <td>@car.ManufactureYear</td>
                <td>
                    @Html.ActionLink("Details", "Details", "Car", new { carId = car.Id }, new { @class = "btn btn-sm btn-outline-secondary" })
                    @Html.ActionLink("Edit", "Edit", "Car", new { carId = car.Id }, new { @class = "btn btn-sm btn-outline-primary" })

                    @using (Html.BeginForm("Delete", "Car", new { carId = car.Id }, FormMethod.Post, new { @class = "d-inline" }))
                    {
                       
                        <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                    }
                </td>
            </tr>
        }
        </tbody>
    </table>
}
