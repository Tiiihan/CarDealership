@model CarDealershipFramework.ViewModels.CarViewModel

@{
    ViewBag.Title = "Edit car";
}

<h2>Edit car</h2>

@using (Html.BeginForm("Edit", "Car", new { carId = Model.Id }, FormMethod.Post, null))
{
   
    @Html.HiddenFor(model => model.Id)
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })

    <div class="mb-3">
        @Html.LabelFor(model => model.Model, new { @class = "form-label" })
        @Html.TextBoxFor(model => model.Model, new { @class = "form-control" })
        @Html.ValidationMessageFor(model => model.Model, "", new { @class = "text-danger" })
    </div>

    <div class="mb-3">
        @Html.LabelFor(model => model.Make, new { @class = "form-label" })
        @Html.TextBoxFor(model => model.Make, new { @class = "form-control" })
        @Html.ValidationMessageFor(model => model.Make, "", new { @class = "text-danger" })
    </div>

    <div class="mb-3">
        @Html.LabelFor(model => model.ManufactureYear, new { @class = "form-label" })
        @Html.TextBoxFor(model => model.ManufactureYear, new { @class = "form-control", type = "number" })
        @Html.ValidationMessageFor(model => model.ManufactureYear, "", new { @class = "text-danger" })
    </div>

    <div class="mb-3">
        @Html.LabelFor(model => model.DealershipId, new { @class = "form-label" })
        @Html.DropDownListFor(model => model.DealershipId, Model.DealershipOptions, "Select a dealership", new { @class = "form-select" })
        @Html.ValidationMessageFor(model => model.DealershipId, "", new { @class = "text-danger" })
    </div>

    <button type="submit" class="btn btn-primary">Save</button>
    @Html.ActionLink("Cancel", "Details", "Car", new { carId = Model.Id }, new { @class = "btn btn-outline-secondary" })
}
