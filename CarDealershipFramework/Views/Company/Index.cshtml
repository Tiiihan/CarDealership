@model IEnumerable<CarDealershipFramework.ViewModels.CompanyViewModel>

@{
    ViewBag.Title = "Companies";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Companies</h2>
    @Html.ActionLink("Add company", "Create", "Company", null, new { @class = "btn btn-primary" })
</div>

@if (!Model.Any())
{
    <p>No companies have been added yet.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Name</th>
                <th>Country</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var company in Model)
        {
            <tr>
                <td>@company.Name</td>
                <td>@company.Country</td>
                <td>
                    @Html.ActionLink("Details", "Details", "Company", new { companyId = company.Id }, new { @class = "btn btn-sm btn-outline-secondary" })
                    @Html.ActionLink("Edit", "Edit", "Company", new { companyId = company.Id }, new { @class = "btn btn-sm btn-outline-primary" })

                    @using (Html.BeginForm("Delete", "Company", new { companyId = company.Id }, FormMethod.Post, new { @class = "d-inline" }))
                    {
                       
                        <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                    }
                </td>
            </tr>
        }
        </tbody>
    </table>
}
