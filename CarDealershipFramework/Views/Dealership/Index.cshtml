@model IEnumerable<CarDealershipFramework.ViewModels.DealershipViewModel>

@{
    ViewBag.Title = "Dealerships";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Dealerships</h2>
    @Html.ActionLink("Add dealership", "Create", "Dealership", null, new { @class = "btn btn-primary" })
</div>

@if (!Model.Any())
{
    <p>No dealerships have been added yet.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Name</th>
                <th>License</th>
                <th>City</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var dealership in Model)
        {
            <tr>
                <td>@dealership.Name</td>
                <td>@dealership.License</td>
                <td>@dealership.City</td>
                <td>
                    @Html.ActionLink("Details", "Details", "Dealership", new { dealershipId = dealership.Id }, new { @class = "btn btn-sm btn-outline-secondary" })
                    @Html.ActionLink("Edit", "Edit", "Dealership", new { dealershipId = dealership.Id }, new { @class = "btn btn-sm btn-outline-primary" })

                    @using (Html.BeginForm("Delete", "Dealership", new { dealershipId = dealership.Id }, FormMethod.Post, new { @class = "d-inline" }))
                    {
                       
                        <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                    }
                </td>
            </tr>
        }
        </tbody>
    </table>
}
