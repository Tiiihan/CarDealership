@model IEnumerable<CarDealershipFramework.ViewModels.DealershipViewModel>

@{
    ViewBag.Title = "Dealerships";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Dealerships</h2>
    @Html.RouteLink("Add dealership", "DealershipCreate", null, new { @class = "btn btn-primary" })
</div>

@if (!Model.Any())
{
    <p>No dealerships have been added yet.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Name</th>
                <th>License</th>
                <th>City</th>
                <th>Partner companies</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var dealership in Model)
        {
            <tr>
                <td>@dealership.Name</td>
                <td>@dealership.License</td>
                <td>@dealership.City</td>
                <td>@string.Join(", ", dealership.CompanyNames)</td>
                <td>
                    @Html.RouteLink("Details", "DealershipDetails", new { dealershipId = dealership.Dealership_id }, new { @class = "btn btn-sm btn-outline-secondary" })
                    @Html.RouteLink("Edit", "DealershipEdit", new { dealershipId = dealership.Dealership_id }, new { @class = "btn btn-sm btn-outline-primary" })

                    @using (Html.BeginRouteForm("DealershipDelete", new { dealershipId = dealership.Dealership_id }, FormMethod.Post, new { @class = "d-inline" }))
                    {
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                    }
                </td>
            </tr>
        }
        </tbody>
    </table>
}
