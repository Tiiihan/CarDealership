@model IEnumerable<CarViewModel>

@{
    ViewData["Title"] = "Cars";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Cars</h2>
    <div>
        <a asp-action="Statistics" class="btn btn-outline-secondary">City statistics</a>
        <a asp-action="Create" class="btn btn-primary">Add car</a>
    </div>
</div>

@if (!Model.Any())
{
    <p>No cars have been added yet.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Make</th>
                <th>Model</th>
                <th>Manufacture year</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var car in Model)
        {
            <tr>
                <td>@car.Make</td>
                <td>@car.Model</td>
                <td>@car.ManufactureYear</td>
                <td>
                    <a asp-action="Details" asp-route-id="@car.Id" class="btn btn-sm btn-outline-secondary">Details</a>
                    <a asp-action="Edit" asp-route-id="@car.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                    <form asp-action="Delete" asp-route-id="@car.Id" method="post" class="d-inline">
                        <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                    </form>
                </td>
            </tr>
        }
        </tbody>
    </table>
}
