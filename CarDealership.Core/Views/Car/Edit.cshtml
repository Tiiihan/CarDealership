@model CarViewModel

@{
    ViewData["Title"] = "Edit car";
}

<h2>Edit car</h2>

<form asp-action="Edit" asp-route-id="@Model.Id" method="post">
    <input asp-for="Id" type="hidden" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="Model" class="form-label"></label>
        <input asp-for="Model" class="form-control" />
        <span asp-validation-for="Model" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Make" class="form-label"></label>
        <input asp-for="Make" class="form-control" />
        <span asp-validation-for="Make" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="ManufactureYear" class="form-label"></label>
        <input asp-for="ManufactureYear" type="number" class="form-control" />
        <span asp-validation-for="ManufactureYear" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="DealershipId" class="form-label"></label>
        <select asp-for="DealershipId" asp-items="Model.DealershipOptions" class="form-select">
            <option value="">Select a dealership</option>
        </select>
        <span asp-validation-for="DealershipId" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Cancel</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
