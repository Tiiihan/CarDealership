@model DealershipViewModel

@{
    ViewData["Title"] = "Dealership details";
}

<h2>@Model.Name</h2>

@if (TempData["Error"] is string errorMessage)
{
    <div class="alert alert-danger">@errorMessage</div>
}

<dl class="row">
    <dt class="col-sm-3">License</dt>
    <dd class="col-sm-9">@Model.License</dd>

    <dt class="col-sm-3">City</dt>
    <dd class="col-sm-9">@Model.City</dd>

    <dt class="col-sm-3">Phone</dt>
    <dd class="col-sm-9">@Model.Phone</dd>
</dl>

<h3>Partner companies</h3>
@if (!Model.CompanyNames.Any())
{
    <p>No companies are linked to this dealership.</p>
}
else
{
    <ul>
    @foreach (var companyName in Model.CompanyNames)
    {
        <li>@companyName</li>
    }
    </ul>
}

<h3>Cars</h3>
@if (!Model.Cars.Any())
{
    <p>No cars are assigned to this dealership.</p>
}
else
{
    <ul>
    @foreach (var car in Model.Cars)
    {
        <li>
            <a asp-controller="Car" asp-action="Details" asp-route-id="@car.Id">
                @car.Make @car.Model (@car.ManufactureYear)
            </a>
        </li>
    }
    </ul>
}

<a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Edit</a>
<a asp-action="Index" class="btn btn-outline-secondary">Back to dealerships</a>
